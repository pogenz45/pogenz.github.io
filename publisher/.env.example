# ==========================================================
# Hybrid Auto-Publisher Environment Variables
# Copy file này thành `.env` và điền khóa thật (KHÔNG commit `.env`)
# ==========================================================

# Múi giờ mặc định dùng cho hẹn giờ đăng
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Đường dẫn file cấu hình danh sách kênh & SQLite DB
CHANNELS_CONFIG_PATH=config/channels.json
DATABASE_PATH=data/publisher.db

# ----------------------------------------------------------
# 1. YOUTUBE OFFICIAL API v3 (Miễn phí - 100 video/ngày mặc định)
# Tải file JSON Desktop OAuth Client từ Google Cloud Console
# ----------------------------------------------------------
YOUTUBE_CLIENT_SECRETS_FILE=.secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=.secrets/youtube_token.json

# ----------------------------------------------------------
# 2. TIKTOK PROVIDER — CHỌN 1 TRONG 2 (hoặc cấu hình cả 2 để dự phòng)
# ----------------------------------------------------------

# [Khuyến nghị $0 cho 2 kênh TikTok] Zernio (trước đây là Late / getlate.dev)
ZERNIO_API_KEY=your_zernio_api_key_here
ZERNIO_BASE_URL=https://zernio.com/api/v1

# [Dự phòng / Scale 5+ cặp kênh] Upload-Post (upload-post.com)
UPLOAD_POST_API_KEY=your_upload_post_api_key_here
UPLOAD_POST_BASE_URL=https://api.upload-post.com
